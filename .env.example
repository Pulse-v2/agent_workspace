# Web application (public values are safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server and background worker only. Never expose these values to client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
EMBEDDING_API_KEY=your-embedding-api-key
LLM_MODEL=your-chat-model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
WORKER_POLL_INTERVAL_MS=3000
MAX_AGENT_STEPS=8
MAX_AGENT_DURATION_MS=300000
MAX_AGENT_COST_USD=2
MAX_AGENT_RETRIES=3
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=2000
LLM_INPUT_COST_PER_MILLION=0.15
LLM_OUTPUT_COST_PER_MILLION=0.60
DEMO_MODE=true

# Optional, display-only values for the web app (apps/web/.env.local): shown on the Settings page
# and used for the demo-mode notice. They never expose keys.
# LLM_PROVIDER=openai
# LLM_MODEL=your-chat-model
# EMBEDDING_MODEL=text-embedding-3-small
# DEMO_MODE=true
